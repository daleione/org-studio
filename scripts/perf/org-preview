#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
FIXTURE_DIR="${ORG_STUDIO_PERF_FIXTURE_DIR:-$ROOT_DIR/target/perf-fixtures}"
RESULT_ROOT="${ORG_STUDIO_PERF_RESULT_DIR:-$ROOT_DIR/target/perf-results}"
DEFAULT_MIB="${ORG_STUDIO_PERF_MIB:-50}"
DEFAULT_FRAMES="${ORG_STUDIO_PERF_FRAMES:-5000}"
DEFAULT_WARMUP="${ORG_STUDIO_PERF_WARMUP_FRAMES:-1200}"
DEFAULT_PIXELS="${ORG_STUDIO_PERF_SCROLL_PIXELS:-16}"
DEFAULT_MINIMAP_WIDTH="${ORG_STUDIO_PERF_MINIMAP_WIDTH:-auto}"
DEFAULT_WINDOW_WIDTH="${ORG_STUDIO_PERF_WINDOW_WIDTH:-920}"
DEFAULT_WINDOW_HEIGHT="${ORG_STUDIO_PERF_WINDOW_HEIGHT:-720}"
DEFAULT_DISABLE_INACTIVE_THROTTLE="${ORG_STUDIO_PERF_DISABLE_INACTIVE_THROTTLE:-1}"
DEFAULT_STYLE_SWITCHES="${ORG_STUDIO_PERF_STYLE_SWITCHES:-20}"
DEFAULT_STYLE_PIXELS="${ORG_STUDIO_PERF_STYLE_SCROLL_PIXELS:-16}"
DEFAULT_STYLE_P95_MS="${ORG_STUDIO_PERF_STYLE_P95_MS:-16.67}"
DEFAULT_STYLE_LATE_RATE_PCT="${ORG_STUDIO_PERF_STYLE_LATE_RATE_PCT:-10}"

usage() {
    cat <<'EOF'
Usage: scripts/perf/org-preview COMMAND [ARGS]

Commands:
  prepare [MIB ...]           Generate fixtures (default: 1 10 50).
  build                       Build all release binaries.
  cpu [MIB]                   Run the visible-block CPU benchmark.
  incremental [MIB]           Gate incremental edit p95 and chunk reuse.
  first-frame [MIB]           Measure the first readable GPUI frame.
  minimap-first-frame [MIB]   Measure minimap index, first tile, and first pixels.
  scroll [PIXELS] [MIB]       Run one GUI scroll sample.
  style [MIB]                 Gate 10 Base/Warm Clay round trips while scrolling
                              and resizing between narrow and wide viewports.
  profile [PIXELS] [MIB]      Run scroll plus GPUI profiling spans.
  suite [MIB]                 Build, prepare, then run CPU and 0/16/80px GUI samples.
  gate [MIB ...]              Run first-frame, scroll, memory, and incremental gates
                              (default: 1 10 50).
  help                        Show this help.

Configuration environment variables:
  ORG_STUDIO_PERF_FIXTURE_DIR
  ORG_STUDIO_PERF_RESULT_DIR
  ORG_STUDIO_PERF_MIB                 default 50
  ORG_STUDIO_PERF_FRAMES              default 5000
  ORG_STUDIO_PERF_WARMUP_FRAMES       default 1200
  ORG_STUDIO_PERF_SCROLL_PIXELS        default 16
  ORG_STUDIO_PERF_MINIMAP_WIDTH        default auto; 48..480 logical px
  ORG_STUDIO_PERF_WINDOW_WIDTH         default 920 logical px
  ORG_STUDIO_PERF_WINDOW_HEIGHT        default 720 logical px
  ORG_STUDIO_PERF_STYLE_SWITCHES       default 20 (10 round trips)
  ORG_STUDIO_PERF_STYLE_SCROLL_PIXELS  default 16 pixels per frame
  ORG_STUDIO_PERF_STYLE_P95_MS         default 16.67
  ORG_STUDIO_PERF_STYLE_LATE_RATE_PCT  default 10
  ORG_STUDIO_PERF_DISABLE_INACTIVE_THROTTLE
                                         default 1; set 0 to test GPUI background throttling

GUI scroll runs disable GPUI's inactive-window throttle by default, but remain
paced by the target display link. Move the window to the Mac internal ProMotion
display before the warmup counter reaches zero.
EOF
}

die() {
    printf 'org-preview-perf: %s\n' "$*" >&2
    exit 2
}

require_positive_integer() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || die "$2 must be a positive integer: $1"
}

require_nonnegative_number() {
    [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "$2 must be a non-negative number: $1"
}

require_boolean() {
    [[ "$1" == "0" || "$1" == "1" ]] || die "$2 must be 0 or 1: $1"
}

fixture_path() {
    printf '%s/org-preview-%sm.org' "$FIXTURE_DIR" "$1"
}

new_run_dir() {
    local label="$1"
    local run_id
    run_id="$(date '+%Y%m%d-%H%M%S')-$label"
    RUN_DIR="$RESULT_ROOT/$run_id"
    mkdir -p "$RUN_DIR"
    {
        printf 'run_id=%s\n' "$run_id"
        printf 'started_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        printf 'uname=%s\n' "$(uname -a)"
        if command -v sw_vers >/dev/null 2>&1; then
            sw_vers | tr '\n' ' '
            printf '\n'
        fi
    } >"$RUN_DIR/metadata.txt"
    printf 'org_preview_perf_results path=%s\n' "$RUN_DIR"
}

ensure_fixture() {
    local mib="$1"
    local fixture
    fixture="$(fixture_path "$mib")"
    if [[ ! -f "$fixture" ]]; then
        prepare "$mib"
    fi
}

ensure_release_binaries() {
    [[ -x "$ROOT_DIR/target/release/org-studio" ]] || die "release binary missing; run: scripts/perf/org-preview build"
    [[ -x "$ROOT_DIR/target/release/org-preview-cpu-bench" ]] || die "CPU benchmark missing; run: scripts/perf/org-preview build"
}

run_measured() {
    if [[ "$(uname -s)" == "Darwin" && -x /usr/bin/time ]]; then
        /usr/bin/time -l "$@"
    else
        "$@"
    fi
}

prepare() {
    local sizes=("$@")
    if [[ ${#sizes[@]} -eq 0 ]]; then
        sizes=(1 10 50)
    fi
    mkdir -p "$FIXTURE_DIR"
    for mib in "${sizes[@]}"; do
        require_positive_integer "$mib" "fixture MiB"
        cargo run --quiet --release --bin generate-org-fixture -- \
            "$(fixture_path "$mib")" "$mib"
    done
}

build_release() {
    cargo build --release --bins
}

run_cpu() {
    local mib="${1:-$DEFAULT_MIB}"
    require_positive_integer "$mib" "fixture MiB"
    ensure_fixture "$mib"
    ensure_release_binaries
    new_run_dir "cpu-${mib}m"
    "$ROOT_DIR/target/release/org-preview-cpu-bench" "$(fixture_path "$mib")" \
        2>&1 | tee "$RUN_DIR/cpu.log"
}

run_incremental() {
    local mib="${1:-$DEFAULT_MIB}"
    require_positive_integer "$mib" "fixture MiB"
    ensure_fixture "$mib"
    ORG_STUDIO_READING_FIXTURE="$(fixture_path "$mib")" \
        cargo test --release --features benchmarks --lib \
        reading_ -- --nocapture
}

run_first_frame() {
    local mib="${1:-$DEFAULT_MIB}"
    require_positive_integer "$mib" "fixture MiB"
    ensure_fixture "$mib"
    ensure_release_binaries
    require_boolean "$DEFAULT_DISABLE_INACTIVE_THROTTLE" "ORG_STUDIO_PERF_DISABLE_INACTIVE_THROTTLE"
    new_run_dir "first-frame-${mib}m"
    printf 'inactive_window_throttle_disabled=%s\n' "$DEFAULT_DISABLE_INACTIVE_THROTTLE" >>"$RUN_DIR/metadata.txt"
    run_measured env \
        ORG_STUDIO_SCROLL_BENCH_SURFACE=reading \
        ORG_STUDIO_RELOAD_BENCH=1 \
        ORG_STUDIO_EXIT_AFTER_FIRST_FRAME=1 \
        ORG_STUDIO_BENCH_DISABLE_INACTIVE_THROTTLE="$DEFAULT_DISABLE_INACTIVE_THROTTLE" \
        "$ROOT_DIR/target/release/org-studio" "$(fixture_path "$mib")" \
        2>&1 | tee "$RUN_DIR/first-frame.log"
}

run_minimap_first_frame() {
    local mib="${1:-$DEFAULT_MIB}"
    require_positive_integer "$mib" "fixture MiB"
    ensure_fixture "$mib"
    ensure_release_binaries
    require_boolean "$DEFAULT_DISABLE_INACTIVE_THROTTLE" "ORG_STUDIO_PERF_DISABLE_INACTIVE_THROTTLE"
    new_run_dir "minimap-first-frame-${mib}m"
    printf 'inactive_window_throttle_disabled=%s\n' "$DEFAULT_DISABLE_INACTIVE_THROTTLE" >>"$RUN_DIR/metadata.txt"
    ORG_STUDIO_MINIMAP=1 \
    ORG_STUDIO_MINIMAP_PERF=1 \
    ORG_STUDIO_EXIT_AFTER_MINIMAP_FRAME=1 \
    ORG_STUDIO_SCROLL_BENCH_SURFACE=reading \
    ORG_STUDIO_BENCH_DISABLE_INACTIVE_THROTTLE="$DEFAULT_DISABLE_INACTIVE_THROTTLE" \
        "$ROOT_DIR/target/release/org-studio" "$(fixture_path "$mib")" \
        2>&1 | tee "$RUN_DIR/minimap-first-frame.log"
}

run_scroll() {
    local pixels="${1:-$DEFAULT_PIXELS}"
    local mib="${2:-$DEFAULT_MIB}"
    local profile="${3:-0}"
    require_nonnegative_number "$pixels" "scroll pixels"
    require_positive_integer "$mib" "fixture MiB"
    [[ "$(uname -s)" == "Darwin" ]] || die "GUI scroll benchmark currently requires macOS"
    ensure_fixture "$mib"
    ensure_release_binaries
    require_boolean "$DEFAULT_DISABLE_INACTIVE_THROTTLE" "ORG_STUDIO_PERF_DISABLE_INACTIVE_THROTTLE"
    local style_switches="${ORG_STUDIO_STYLE_BENCH_SWITCHES:-0}"
    new_run_dir "scroll-${pixels}px-${mib}m-style${style_switches}"
    {
        printf 'minimap_enabled=%s\n' "${ORG_STUDIO_MINIMAP:-settings}"
        printf 'minimap_width=%s\n' "$DEFAULT_MINIMAP_WIDTH"
        printf 'window_size=%sx%s\n' "$DEFAULT_WINDOW_WIDTH" "$DEFAULT_WINDOW_HEIGHT"
        printf 'requested_display_index=%s\n' "${ORG_STUDIO_DISPLAY_INDEX:-manual}"
        printf 'inactive_window_throttle_disabled=%s\n' "$DEFAULT_DISABLE_INACTIVE_THROTTLE"
        printf 'style_switches=%s\n' "$style_switches"
    } >>"$RUN_DIR/metadata.txt"
    printf 'Move the benchmark window to the Mac internal display during the %s-frame warmup.\n' \
        "$DEFAULT_WARMUP"
    local -a env_args=(
        "ORG_STUDIO_SCROLL_BENCH_SURFACE=reading"
        "ORG_STUDIO_SCROLL_BENCH_WARMUP_FRAMES=$DEFAULT_WARMUP"
        "ORG_STUDIO_SCROLL_BENCH_FRAMES=$DEFAULT_FRAMES"
        "ORG_STUDIO_SCROLL_BENCH_PIXELS=$pixels"
        "ORG_STUDIO_MINIMAP_WIDTH=$DEFAULT_MINIMAP_WIDTH"
        "ORG_STUDIO_WINDOW_WIDTH=$DEFAULT_WINDOW_WIDTH"
        "ORG_STUDIO_WINDOW_HEIGHT=$DEFAULT_WINDOW_HEIGHT"
        "ORG_STUDIO_BENCH_DISABLE_INACTIVE_THROTTLE=$DEFAULT_DISABLE_INACTIVE_THROTTLE"
        "ORG_STUDIO_STYLE_BENCH_SWITCHES=$style_switches"
        "ORG_STUDIO_STYLE_BENCH_NARROW_WIDTH=${ORG_STUDIO_STYLE_BENCH_NARROW_WIDTH:-760}"
        "ORG_STUDIO_STYLE_BENCH_WIDE_WIDTH=${ORG_STUDIO_STYLE_BENCH_WIDE_WIDTH:-1400}"
    )
    if [[ "$profile" == "1" ]]; then
        env_args+=("ORG_STUDIO_PROFILE_FRAMES=1")
    fi
    run_measured env "${env_args[@]}" \
        "$ROOT_DIR/target/release/org-studio" "$(fixture_path "$mib")" \
        2>&1 | tee "$RUN_DIR/scroll.log"
}

run_style_gate() {
    local mib="${1:-$DEFAULT_MIB}"
    require_positive_integer "$mib" "fixture MiB"
    require_positive_integer "$DEFAULT_STYLE_SWITCHES" "ORG_STUDIO_PERF_STYLE_SWITCHES"
    require_nonnegative_number "$DEFAULT_STYLE_PIXELS" "ORG_STUDIO_PERF_STYLE_SCROLL_PIXELS"
    require_nonnegative_number "$DEFAULT_STYLE_P95_MS" "ORG_STUDIO_PERF_STYLE_P95_MS"
    require_nonnegative_number "$DEFAULT_STYLE_LATE_RATE_PCT" "ORG_STUDIO_PERF_STYLE_LATE_RATE_PCT"
    local DEFAULT_FRAMES="${ORG_STUDIO_PERF_STYLE_FRAMES:-100}"
    local DEFAULT_WARMUP="${ORG_STUDIO_PERF_STYLE_WARMUP_FRAMES:-60}"
    local DEFAULT_WINDOW_WIDTH="${ORG_STUDIO_PERF_STYLE_WIDE_WIDTH:-1400}"
    local DEFAULT_WINDOW_HEIGHT="${ORG_STUDIO_PERF_STYLE_WINDOW_HEIGHT:-900}"
    ORG_STUDIO_STYLE_BENCH_SWITCHES="$DEFAULT_STYLE_SWITCHES" \
    ORG_STUDIO_STYLE_BENCH_NARROW_WIDTH="${ORG_STUDIO_PERF_STYLE_NARROW_WIDTH:-760}" \
    ORG_STUDIO_STYLE_BENCH_WIDE_WIDTH="$DEFAULT_WINDOW_WIDTH" \
    ORG_STUDIO_MINIMAP=1 \
        run_scroll "$DEFAULT_STYLE_PIXELS" "$mib" 0
    grep -q \
        "org_preview_style_gate switches=$DEFAULT_STYLE_SWITCHES expected=$DEFAULT_STYLE_SWITCHES" \
        "$RUN_DIR/scroll.log" || die "style gate did not complete every requested switch"
    local metrics p95_ms late_rate_pct
    metrics="$(grep 'org_preview_scroll ' "$RUN_DIR/scroll.log" | tail -n 1)"
    [[ -n "$metrics" ]] || die "style gate did not emit scroll metrics"
    p95_ms="$(sed -n 's/.* p95_ms=\([^ ]*\).*/\1/p' <<<"$metrics")"
    late_rate_pct="$(sed -n 's/.* late_rate_pct=\([^ ]*\).*/\1/p' <<<"$metrics")"
    [[ -n "$p95_ms" && -n "$late_rate_pct" ]] || die "style gate emitted malformed metrics"
    awk -v actual="$p95_ms" -v limit="$DEFAULT_STYLE_P95_MS" \
        'BEGIN { exit !(actual <= limit) }' \
        || die "style gate p95 ${p95_ms}ms exceeds ${DEFAULT_STYLE_P95_MS}ms"
    awk -v actual="$late_rate_pct" -v limit="$DEFAULT_STYLE_LATE_RATE_PCT" \
        'BEGIN { exit !(actual <= limit) }' \
        || die "style gate late rate ${late_rate_pct}% exceeds ${DEFAULT_STYLE_LATE_RATE_PCT}%"
}

run_suite() {
    local mib="${1:-$DEFAULT_MIB}"
    require_positive_integer "$mib" "fixture MiB"
    build_release
    prepare 1 10 "$mib"
    run_cpu "$mib"
    run_scroll 0 "$mib" 0
    run_scroll 16 "$mib" 0
    run_scroll 80 "$mib" 0
}

run_gate() {
    local sizes=("$@")
    if [[ ${#sizes[@]} -eq 0 ]]; then
        sizes=(1 10 50)
    fi
    build_release
    prepare "${sizes[@]}"
    local final_mib=""
    for mib in "${sizes[@]}"; do
        require_positive_integer "$mib" "fixture MiB"
        final_mib="$mib"
        run_cpu "$mib"
        run_first_frame "$mib"
        run_scroll 16 "$mib" 0
    done
    run_incremental "$final_mib"
    run_style_gate "$final_mib"
}

cd "$ROOT_DIR"
command="${1:-help}"
shift || true
case "$command" in
    prepare) prepare "$@" ;;
    build) build_release ;;
    cpu) run_cpu "$@" ;;
    incremental) run_incremental "$@" ;;
    first-frame) run_first_frame "$@" ;;
    minimap-first-frame) run_minimap_first_frame "$@" ;;
    scroll) run_scroll "${1:-$DEFAULT_PIXELS}" "${2:-$DEFAULT_MIB}" 0 ;;
    style) run_style_gate "${1:-$DEFAULT_MIB}" ;;
    profile) run_scroll "${1:-$DEFAULT_PIXELS}" "${2:-$DEFAULT_MIB}" 1 ;;
    suite) run_suite "$@" ;;
    gate) run_gate "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $command" ;;
esac
