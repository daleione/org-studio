# Rust build output.
/target/

# Packaged application artifacts.
/dist/

# Generated performance fixtures and benchmark output.
/preview-benchmark.org

# Local profiling output.
*.profraw
*.profdata
*.trace

# macOS metadata and Finder state.
.DS_Store
.AppleDouble
.LSOverride
# Finder's custom icon file ends in a control character, unlike an icons directory.
Icon[[:cntrl:]]
._*

# Editor and IDE-local state.
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment and temporary files.
.env
.env.*
!.env.example
*.log
*.tmp
